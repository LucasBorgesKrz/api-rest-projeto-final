{
  "info": {
    "name": "API Projeto Final – Testes",
    "description": "Coleção de testes da API: fluxos de sucesso (cadastro, login, rota protegida, CRUD) e erros esperados (400, 401, 403, 404, 409).\n\nComo usar: importe esta coleção e um dos ambientes de `docs/postman/` (local ou produção), preencha `adminEmail`/`adminSenha` no ambiente e rode a coleção inteira (Runner). Ou, pelo terminal: `npm run test:collection`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@exemplo.com"
    },
    {
      "key": "adminSenha",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const ct = pm.response.headers.get('Content-Type') || '';",
          "if (pm.response.code >= 400 && ct.includes(\"application/json\")) {",
          "  pm.test('Erro segue o padrão da API (status, error, message, details, timestamp)', () => {",
          "    const j = pm.response.json();",
          "    pm.expect(j).to.have.all.keys('status', 'error', 'message', 'details', 'timestamp');",
          "    pm.expect(j.status).to.eql(pm.response.code);",
          "    pm.expect(j.details).to.be.an('array');",
          "  });",
          "}",
          "pm.test('Resposta em até 8 segundos (a 1ª pode demorar se a nuvem estiver acordando)', () => pm.expect(pm.response.responseTime).to.be.below(8000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Sistema",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('API está ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Sucesso – fluxo principal",
      "description": "Cadastro, login (token), rota protegida e CRUD de produtos. Rode em ordem (o Runner já faz isso).",
      "item": [
        {
          "name": "2.1 Cadastro de usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno Teste\",\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', 'aluno.' + Date.now() + '@exemplo.com');",
                  "pm.collectionVariables.set('userSenha', 'Senha123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Perfil é comum', () => pm.expect(j.perfil).to.eql('comum'));",
                  "pm.test('Resposta NÃO contém senha nem hash', () => pm.expect(pm.response.text()).to.not.match(/senha|hash|\\$2[aby]\\$/i));",
                  "pm.collectionVariables.set('userId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Login (retorna o token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Retorna token JWT (3 partes)', () => pm.expect(j.token.split('.')).to.have.lengthOf(3));",
                  "pm.test('tokenType é Bearer e há expiração', () => { pm.expect(j.tokenType).to.eql('Bearer'); pm.expect(j.expiresIn).to.be.above(0); });",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Login do admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Requer as variáveis adminEmail e adminSenha (ambiente). A senha do admin NÃO fica no repositório."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 (confira adminEmail/adminSenha no ambiente)', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Perfil admin', () => pm.expect(j.usuario.perfil).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Acesso a rota protegida (GET /perfil)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "perfil"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna o usuário logado', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('userEmail')));",
                  "pm.test('Sem senha na resposta', () => pm.expect(pm.response.text()).to.not.match(/senha|hash/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Criar produto (autenticado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Notebook Gamer\",\n  \"categoria\": \"eletronicos\",\n  \"preco\": 4999.9,\n  \"estoque\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/produtos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Produto criado com id e autor', () => { pm.expect(j.id).to.be.a('number'); pm.expect(j.criadoPor).to.eql(pm.collectionVariables.get('userId')); });",
                  "pm.test('Cabeçalho Location aponta para o produto', () => pm.expect(pm.response.headers.get('Location')).to.eql('/produtos/' + j.id));",
                  "pm.collectionVariables.set('produtoId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Listar com paginação, filtros e ordenação",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/produtos?page=1&limit=5&categoria=eletronicos&ativo=true&minPrice=100&maxPrice=3000&sort=preco&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "categoria",
                  "value": "eletronicos"
                },
                {
                  "key": "ativo",
                  "value": "true"
                },
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "maxPrice",
                  "value": "3000"
                },
                {
                  "key": "sort",
                  "value": "preco"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Tem data (até 5 itens) e meta de paginação', () => { pm.expect(j.data.length).to.be.at.most(5); pm.expect(j.meta).to.include.keys('totalItems', 'itemsPerPage', 'currentPage', 'totalPages', 'first', 'prev', 'next', 'last'); });",
                  "pm.test('Todos respeitam os filtros', () => j.data.forEach((p) => { pm.expect(p.categoria).to.eql('eletronicos'); pm.expect(p.ativo).to.eql(true); pm.expect(p.preco).to.be.within(100, 3000); }));",
                  "pm.test('Ordenado por preço decrescente', () => { const precos = j.data.map((p) => p.preco); pm.expect(precos).to.eql([...precos].sort((a, b) => b - a)); });",
                  "pm.test('Links HATEOAS preservam os filtros', () => pm.expect(j.meta.last).to.include('categoria=eletronicos').and.include('sort=preco'));"
                ]
              }
            }
          ]
        },
        {
