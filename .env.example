# MODELO de configuração. Copie para .env — ou rode `npm start`, que cria o .env
# sozinho com valores ALEATÓRIOS. O arquivo .env NUNCA deve ser commitado (.gitignore).
# Em produção (Render, Railway...) estas variáveis são cadastradas no painel da nuvem.

PORT=3000
NODE_ENV=development

# Segredo que ASSINA os tokens JWT. Mínimo 32 caracteres, aleatório.
# Gerar:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio
JWT_EXPIRES_IN=1h

# Custo do bcrypt (cada +1 dobra o tempo de hash).
BCRYPT_ROUNDS=10

# Conta admin criada ao iniciar o servidor. É a única forma de existir um admin
# (o registro público só cria contas comuns). Defina uma senha forte (8+ caracteres, letra e número).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-do-admin1

# Proteção de /login e /register contra força bruta (tentativas por janela, por IP).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=40

# Atrás de proxy/balanceador na nuvem use 1; local deixe 0.
TRUST_PROXY=0
